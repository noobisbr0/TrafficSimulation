/* 1. Глобальные настройки текста и фона окон */
QMainWindow, QDockWidget, QScrollArea, QTabWidget {
    background-color: #1E1E24;
    color: #ECEFF1;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}

/* 2. Текст и индикаторы */
QLabel, QCheckBox, QRadioButton {
    color: #ECEFF1;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
    background: transparent;
    border: 1px solid #536DFE;
    margin-right: 4px;
}

QRadioButton::indicator {
    border-radius: 7px;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    background: #252836;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #3D5AFE;
    border: 1px solid #3D5AFE;
}

QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
    border: 1px solid #3A3F55;
    background: transparent;
}

/* 3. Фоны панелей и доков */
QWidget#scrollBg, ParametersPanel {
    background-color: #1E1E24;
}

QScrollArea {
    border: none;
    background-color: #1E1E24;
}

QDockWidget > QWidget {
    background-color: #1E1E24;
}

QDockWidget::title {
    background: #252836;
    padding: 6px;
    color: #ECEFF1;
    border-bottom: 1px solid #3A3F55;
}

/* 4. Карточный дизайн */
QGroupBox {
    border: none;
    border-radius: 10px;
    margin-top: 16px;
    background-color: #2A2D3E;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0;
    color: #ECEFF1;
    font-weight: bold;
    background: transparent;
}

/* Подзаголовки направлений светофоров */
QLabel#approachTitle {
    color: #ECEFF1;
    font-weight: bold;
    font-size: 13px;
}

/* 5. Элементы ввода (SpinBox, ComboBox) */
QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1E1E24;
    color: #ECEFF1;
    border: 1px solid #3A3F55;
    border-radius: 4px;
    padding: 2px 4px;
}

/* Принудительно отключаем всплывающее меню со служебными скроллерами */
QComboBox {
    combobox-popup: 0;
}

QSpinBox::up-button, QSpinBox::down-button, 
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    width: 0px; 
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #252836;
    color: #ECEFF1;
    border: 1px solid #3A3F55;
    selection-background-color: #3D5AFE;
    outline: none;
    padding: 0px;
}

QComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 2px 8px;
}

/* 6. Вкладки */
QTabWidget::pane {
    border: 1px solid #3A3F55;
    background: #2A2D3E;
    border-radius: 8px;
}

QTabBar::tab {
    background: #252836;
    border: 1px solid #3A3F55;
    padding: 6px 12px;
    color: #90A4AE;
}

QTabBar::tab:selected {
    background: #3D5AFE;
    color: white;
}

/* 7. Ползунки (Слайдеры) */
QSlider::groove:horizontal {
    height: 6px;
    background: #3A3F55;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #3D5AFE;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

/* 8. Скроллбары */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #3A3F55;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #536DFE;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 9. Кнопки плеера */
QPushButton {
    background-color: #3D5AFE;
    color: white;
    border: none;
    padding: 8px 12px;
    font-weight: bold;
}

QPushButton:hover { background-color: #536DFE; }
QPushButton:pressed { background-color: #304FFE; }

QPushButton#btnGroupLeft {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    border-right: 1px solid #283593;
}

QPushButton#btnGroupMiddle {
    border-radius: 0px;
    border-right: 1px solid #283593;
}

QPushButton#btnGroupRight {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}
